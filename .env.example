# ====================================================================
# FairFlow Deployment & On-Chain Configuration
# ====================================================================
# Duplicate this file as ".env" in the project root:
#   c:\Users\LENOVO\Documents\fairflow\.env
#
# NOTE: .env is git-ignored and will NEVER be committed.
# ====================================================================

# Deployer private key (format: 0x... or without 0x)
# Make sure this address has some Base Sepolia testnet ETH!
PRIVATE_KEY=your_private_key_here

# RPC URLs
BASE_SEPOLIA_RPC_URL=https://sepolia.base.org

# Optional: Basescan API Key for contract verification
BASESCAN_API_KEY=

# Populated after deploying the hook in Step 00
# (Set or fill this in once deployed)
HOOK_ADDRESS=
